#add repo
helm repo add bitnami https://charts.bitnami.com/bitnami

#list the repo
helm repo list

#search in repo
helm search repo

#install from repo
helm install nginx bitnami/nginx

#list installed chart
helm list

#update the chart
helm upgrade --install nginx bitnami/nginx --set replicaCount=2

#see the chart history
helm history nginx

#rollback to previous version
helm rollback nginx

#rollback to particular version
helm rollback nginx <revision number>

#uninstall the chart
helm uninstall nginx

